<div class="row">

    <div class="col-md-6 mb-3">
        {{ form_label(form.title) }}
        {{ form_widget(form.title, {
            attr: { class: 'form-control form-control-lg' }
        }) }}
        {{ form_errors(form.title) }}
    </div>

    <div class="col-md-6 mb-3">
        {{ form_label(form.publisher) }}
        {{ form_widget(form.publisher, {
            attr: { class: 'form-control form-control-lg' }
        }) }}
        {{ form_errors(form.publisher) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.edition) }}
        {{ form_widget(form.edition, {
            attr: { class: 'form-control form-control-lg' }
        }) }}
        {{ form_errors(form.edition) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.publicationYear) }}
        {{ form_widget(form.publicationYear, {
            attr: {
                class: form.publicationYear.vars.errors|length > 0
                ? 'form-control form-control-lg is-invalid'
                : 'form-control form-control-lg'
            }
        }) }}
        {{ form_errors(form.publicationYear) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.price) }}

        <div class="input-group input-group-lg">
            <span class="input-group-text">R$</span>

            {{ form_widget(form.price, {
                attr: {
                    class: form.price.vars.errors|length > 0
                    ? 'form-control is-invalid js-money-mask'
                    : 'form-control js-money-mask'
                }
            }) }}
        </div>

        {{ form_errors(form.price) }}
    </div>

</div>
