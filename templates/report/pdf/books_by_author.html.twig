<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <style>
        {{ css|raw }}
    </style>

</head>

<body>

<h1>
    Books By Author Report
</h1>

{% for author, books in report %}

    <h2>
        {{ author }}
    </h2>

    <table>

        <thead>

        <tr>
            <th>Title</th>
            <th>Publisher</th>
            <th>Edition</th>
            <th>Year</th>
            <th>Price</th>
            <th>Subjects</th>
        </tr>

        </thead>

        <tbody>

        {% for book in books %}

            <tr>

                <td>
                    {{ book.book_title }}
                </td>

                <td>
                    {{ book.publisher }}
                </td>

                <td>
                    {{ book.edition }}
                </td>

                <td>
                    {{ book.publication_year }}
                </td>

                <td>
                    {{ book.price|format_currency('BRL', locale='pt_BR') }}
                </td>

                <td>
                    {{ book.subjects }}
                </td>

            </tr>

        {% endfor %}

        </tbody>

    </table>

{% endfor %}

</body>

</html>
