<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover table-striped mb-0">

                <thead class="table-dark">
                <tr>
                    <th>
                        {{ 'name'|trans }}
                    </th>

                    <th>
                        {{ 'actions'|trans }}
                    </th>
                </tr>
                </thead>

                <tbody>

                {% if authors is empty %}

                    <tr>
                        <td colspan="2" class="text-center py-4">
                            {{ 'author.not_found'|trans }}
                        </td>
                    </tr>

                {% else %}

                    {% for author in authors %}

                        <tr>

                            <td>
                                {{ author.name }}
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <a
                                        href="#"
                                        class="text-warning js-edit-modal"
                                        data-modal-target="#createAuthorModal"
                                        data-modal-title="Edit Author"
                                        data-action="/authors/{{ author.id }}/update"
                                        data-id="{{ author.id }}"
                                        data-name="{{ author.name }}"
                                    >
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a
                                        href="{{ path('author_delete', { id: author.id }) }}"
                                        class="text-danger js-confirm-delete"
                                        data-turbo="false"
                                        data-message="{{ 'are_you_sure'|trans|e('html_attr') }}"
                                    >
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>

                        </tr>

                    {% endfor %}

                {% endif %}

                </tbody>

            </table>

        </div>

    </div>

</div>
