<div class="row">

    <div class="col-12 mb-3">

        {{ form_label(form.name) }}

        {{ form_widget(form.name, {
            attr: {
                class: form.name.vars.errors|length > 0
                ? 'form-control form-control-lg is-invalid'
                : 'form-control form-control-lg'
            }
        }) }}

        {{ form_errors(form.name) }}

    </div>

</div>
